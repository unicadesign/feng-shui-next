# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI local artifacts
supabase/.temp/
supabase/.branches/

# Izvorne fotografije i brend paket ne idu u repo (javan je). Čuvaju se van
# repoa, u ../feng-shui-izvori. Ovo hvata originale ako ih neko opet spusti
# u public/; sajt koristi samo isečene i optimizovane varijante.
public/images/IMG_*.jpg
public/images/*-hero.jpg
public/logo/LOGO GAGA*
public/logo/Logo bez linija*
public/logo/Paleta*
public/logo/prvenc*
public/logo/simbol-*
